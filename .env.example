# ---- Server ----
CLIENT_URL=http://localhost:3000

# ---- Database ----
# Full-access role: owns the `app` schema (users, saved_queries, dashboards, widgets)
DATABASE_URL=postgresql+psycopg://insightops:insightops@db:5432/insightops
# Read-only role: SELECT-only grant on the `analytics` schema. This is the connection the
# NL->SQL engine actually executes generated queries against -- enforced at the database
# level, not just in application code, so a bug in the SQL-safety layer can't escalate to
# a write.
ANALYTICS_DATABASE_URL=postgresql+psycopg://analytics_readonly:analytics_readonly@db:5432/insightops

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- OpenAI (NL -> SQL + chart-spec generation) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Query engine guardrails ----
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_SECONDS=10

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
